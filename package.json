{
  "name": "holocall-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "lint": "ultracite check src package.json tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts vercel.json index.html",
    "lint:eslint": "eslint src",
